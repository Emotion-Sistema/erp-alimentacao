# Exemplo SEM segredos. Copie para .env apenas em desenvolvimento.
# Valores reais ficam em variáveis seguras do ambiente (nunca no Git).
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
DATABASE_URL_TESTE=postgres://erp:erp@localhost:5432/erp_teste
NODE_ENV=development
# Chave que cifra o segundo fator: 32 bytes em base64. Em desenvolvimento pode ficar vazia.
# Em homologação e produção vem do cofre (nunca escreva o valor aqui).
ERP_CHAVE_SEGREDOS=
